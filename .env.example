PORT=3000
HOST=127.0.0.1
BOT_USERNAME=qwzpokerbot
BOT_TOKEN=replace_with_new_token_from_botfather
ADMIN_CHAT_ID=replace_with_your_telegram_id_for_private_logs
ADMIN_USER_IDS=
ADMIN_GRANT_MAX_CHIPS=500000
APP_NAME=Weez Poker
NODE_ENV=development
MINIMAL_LAUNCH=false
WITHDRAWALS_ENABLED=true
ADMIN_TELEGRAM_EVENT_TYPES=open,stars_order,crypto_order,stars_paid,crypto_paid,crypto_manual_review,payment_approved,payment_rejected,withdrawal_request,withdrawal_approved,withdrawal_rejected

# Telegram webhook secret_token (передавай при setWebhook, проверяется
# через заголовок X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_WEBHOOK_SECRET=

# Error tracking — Sentry или GlitchTip-совместимый DSN.
# Если пусто, error reporting отключён.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# PostgreSQL. Без DATABASE_URL приложение работает в memory-режиме (только dev).
# DATABASE_URL=postgres://user:pass@host:5432/qwz_poker
# DATABASE_SSL=false
