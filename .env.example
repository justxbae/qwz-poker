# Runtime
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
APP_NAME=Weez Poker
APP_PUBLIC_URL=
BOT_USERNAME=weezpokerbot
BOT_TOKEN=replace_with_new_token_from_botfather
MINIMAL_LAUNCH=true
REAL_MONEY_ENABLED=false
TEST_PLAYERS_ENABLED=true
TABLE_INITIAL_WAIT_TIMEOUT_MS=120000

# Required in production. Generate independent random values; never reuse BOT_TOKEN.
TELEGRAM_WEBHOOK_SECRET=
METRICS_TOKEN=
DEVICE_HASH_SECRET=
SESSION_TTL_SECONDS=86400
MAX_REQUEST_BODY_BYTES=1048576
AUTH_RATE_LIMIT_MAX_ATTEMPTS=30

# Persistence. Both are mandatory when REAL_MONEY_ENABLED=true.
DATABASE_URL=
DATABASE_SSL=true
REDIS_URL=
REDIS_BOOT_TIMEOUT_MS=10000

# Admin access and alerts
ADMIN_CHAT_ID=
ADMIN_USER_IDS=
ADMIN_OWNER_IDS=
ADMIN_FINANCE_IDS=
ADMIN_SUPPORT_IDS=
ADMIN_RISK_IDS=
ADMIN_WEB_SECRET=
ADMIN_GRANT_MAX_CHIPS=500000
ADMIN_TELEGRAM_EVENT_TYPES=open,stars_order,crypto_order,stars_paid,crypto_paid,crypto_manual_review,payment_approved,payment_rejected,withdrawal_request,withdrawal_approved,withdrawal_rejected,reconciliation_alert,crypto_webhook_error,telegram_webhook_unhealthy,daily_owner_report
ADMIN_DAILY_REPORT_ENABLED=true
ADMIN_DAILY_REPORT_HOUR=21

# Deposits
STARS_USDT_RATE=0.01
CRYPTO_WEBHOOK_SECRET=
CRYPTOBOT_API_KEY=
CRYPTOBOT_API_BASE=https://pay.crypt.bot/api
XROCKET_PAY_API_KEY=
XROCKET_PAY_API_BASE=https://pay.xrocket.tg
XROCKET_WEBHOOK_SECRET=
TON_PAYMENTS_ENABLED=false
TON_RECEIVER_ADDRESS=
TON_USDT_RATE=
TON_POLLING_ENABLED=false
TONCENTER_API_KEY=
USDT_TRC20_PAYMENTS_ENABLED=false

# Withdrawals and risk
WITHDRAWALS_ENABLED=false
WITHDRAWAL_RAKE_THRESHOLD_PERCENT=0
RISK_LARGE_WITHDRAWAL_USDT=1000
RISK_LARGE_ADMIN_ADJUST_CHIPS=250000

# Operations
RECONCILIATION_INTERVAL_MS=900000
RECONCILIATION_DRIFT_ALERT_CHIPS=1
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
